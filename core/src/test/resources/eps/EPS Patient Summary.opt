    </annotations>
    <annotations path="[openEHR-EHR-COMPOSITION.health_summary.v1]/content[openEHR-EHR-SECTION.adhoc.v1 and name/value='EPS History of Procedures']/items[openEHR-EHR-EVALUATION.exclusion_global.v1]/data[at0001]/items[at0002, 'Global exclusion of procedures']">
